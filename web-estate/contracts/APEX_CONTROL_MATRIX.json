  "claim_policy": {
    "allowed_before_full_assessment": [
      "designed using the APEX workflow",
      "evaluation target: WCAG 2.2 Level AA",
      "evaluated against [named source] with linked evidence"
    ],
    "prohibited_without_evidence": [
      "ISO compliant",
      "ISO certified",
      "fully accessible",
      "WCAG compliant",
      "legally compliant"
    ]
  },
  "controls": [
    {
      "id": "BOUNDARY-001",
      "gate": 0,
      "severity": "BLOCKER",
      "owner": "Foundry Fabric",
      "sources": [],
      "criterion": "Frontage, Website, Publishing, Domain and Server Foundries have distinct accountable outputs.",
      "evidence": [
        "boundary record"
      ],
      "status": "UNTESTED"
    },
    {
      "id": "CLAIM-001",
